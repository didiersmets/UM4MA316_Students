set clipboard=unnamedplus
set relativenumber
set shiftwidth=4
set autoindent
" backup directory afin de ne pas encombrer les dossiers de TD
set backup
set backupdir=~/.vim/backup//
set cindent
set hlsearch
set incsearch
" showmatch fait clignoter les accolades/parentheses associees quand on les ferme
set showmatch
set matchtime=0.5
set number
syntax on
filetype plugin on
filetype indent on
